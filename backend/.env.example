# Initialize with: python backend/manage.py init-env
# A dedicated local MySQL account is required. URL-encode special password characters.
CAREERPILOT_DATABASE_URL=mysql+pymysql://careerpilot_app:REPLACE_ME@127.0.0.1:3306/careerpilot_app?charset=utf8mb4
CAREERPILOT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CAREERPILOT_ENVIRONMENT=development
CAREERPILOT_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CAREERPILOT_ALLOWED_HOSTS=["127.0.0.1","localhost"]
CAREERPILOT_COOKIE_SECURE=false
CAREERPILOT_SESSION_DAYS=7
CAREERPILOT_CODE_DIGITS=6
CAREERPILOT_CODE_TTL_SECONDS=600
CAREERPILOT_CODE_RESEND_SECONDS=60
CAREERPILOT_CODE_MAX_ATTEMPTS=5
CAREERPILOT_LOGIN_LIMIT=10
CAREERPILOT_LOGIN_WINDOW_SECONDS=300

# Local Mailpit inbox: http://127.0.0.1:8025/
CAREERPILOT_SMTP_HOST=127.0.0.1
CAREERPILOT_SMTP_PORT=1025
CAREERPILOT_SMTP_STARTTLS=false
CAREERPILOT_MAIL_FROM=CareerPilot <noreply@careerpilot.local>

CAREERPILOT_MATERIAL_MAX_BYTES=10485760
CAREERPILOT_MATERIAL_TEXT_LIMIT=200000
CAREERPILOT_MATERIAL_EXTRACT_TIMEOUT=20
CAREERPILOT_JD_TEXT_LIMIT=20000

# Configure locally to enable paid generation. Never commit a real key.
# CAREERPILOT_DEEPSEEK_API_KEY=
CAREERPILOT_MODEL_USAGE_MODE=test
CAREERPILOT_MODEL_TEST_BUDGET_CNY=20
CAREERPILOT_MODEL_TEST_MAX_CALLS=2
CAREERPILOT_MODEL_MONTHLY_BUDGET_CNY=50
CAREERPILOT_MODEL_TIMEOUT_SECONDS=60
CAREERPILOT_MODEL_MAX_OUTPUT_TOKENS=4096
CAREERPILOT_MODEL_REPORT_MAX_OUTPUT_TOKENS=8192
# Replace through verify-pricing after checking provider prices; stale verification blocks new calls.
CAREERPILOT_MODEL_PRICING_VERIFIED_ON=1970-01-01
CAREERPILOT_GENERATION_WORKERS=2

CAREERPILOT_SPEECH_MAX_SECONDS=180
CAREERPILOT_SPEECH_MAX_BYTES=10485760
CAREERPILOT_SPEECH_TIMEOUT_SECONDS=120
# Storage defaults resolve relative to this checkout. Optional absolute-path overrides:
# CAREERPILOT_BACKUP_DIRECTORY=
# CAREERPILOT_MAINTENANCE_DIRECTORY=
