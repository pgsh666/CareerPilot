{
  "name": "careerpilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:materials": "playwright test --config playwright.materials.config.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:service": "playwright test --config playwright.service-regression.config.ts",
    "build:web": "vue-tsc -b && vite build",
    "test:ui": "playwright test --config playwright.operations.config.ts",
    "test:avatar": "playwright test --config playwright.avatar.config.ts"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "lucide-vue-next": "^0.468.0",
    "morphicons": "2.0.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@heroicons/vue": "2.2.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1"
  }
}
